# Engine HTTP service (DEVELOPMENT_PLAN §1.1).
# Copy to `.env` for local dev. The service reads ENGINE_API_KEY from the
# environment and fails closed (503) if it is unset.

# Shared secret between the web app and this service. Callers must send it as the
# `X-Engine-Api-Key` header. Use a long random value in production; must match the
# `ENGINE_API_KEY` set in the PhysicsJotelab web app.
ENGINE_API_KEY=

# Where this service listens locally (uvicorn). PaaS hosts inject their own $PORT.
PORT=8000

# For reference — the web app points at this service via ENGINE_BASE_URL, e.g.
# ENGINE_BASE_URL=http://localhost:8000  (set that in the PhysicsJotelab repo).
